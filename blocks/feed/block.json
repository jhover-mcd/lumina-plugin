{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lumina/instagram-feed",
	"version": "1.0.0",
	"title": "Lumina Instagram Feed",
	"category": "widgets",
	"icon": "instagram",
	"description": "Display a customizable Instagram feed with Lumina's design engine.",
	"keywords": ["instagram", "social", "feed", "gallery"],
	"textdomain": "lumina-instagram-feed",
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"attributes": {
		"useGlobalDesign": {
			"type": "boolean",
			"default": true
		},
		"count": {
			"type": "number",
			"default": 0
		},
		"layout": {
			"type": "string",
			"default": ""
		},
		"columns": {
			"type": "number",
			"default": 0
		},
		"columns_tablet": {
			"type": "number",
			"default": 0
		},
		"columns_mobile": {
			"type": "number",
			"default": 0
		},
		"show_image": {
			"type": "boolean",
			"default": true
		},
		"show_caption": {
			"type": "boolean",
			"default": true
		},
		"show_date": {
			"type": "boolean",
			"default": true
		},
		"show_account": {
			"type": "boolean",
			"default": false
		},
		"show_link": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js"
}
